# Copy this file to .env.local and fill local-only secrets.
# Do not commit .env.local.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FALLBACK_BASE_URL=
OPENAI_MODEL=gpt-5.2

# Optional: dedicated model for 831 economics Anki card generation.
# DeepSeek's API is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Must match the Token configured in the WeChat Official Account test account page.
WECHAT_TOKEN=exampilot-token
